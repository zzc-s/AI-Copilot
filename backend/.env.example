# 环境变量配置模板
# 复制本文件为 .env 并填入你的真实配置

APP_NAME=Job AI Copilot API
APP_ENV=dev

# 数据库配置
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/job_copilot
PGVECTOR_ENABLED=false

# LLM 配置（选择一种方案）

## 方案 1: 阿里云百炼（国内可用）
LLM_PROVIDER=compatible
LLM_API_KEY=your-aliyun-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_PRIMARY=qwen-turbo

## 方案 2: Google Gemini（免费）
# LLM_PROVIDER=compatible
# LLM_API_KEY=your-gemini-api-key-here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL_PRIMARY=gemini-1.5-flash

## 方案 3: 智谱 AI
# LLM_PROVIDER=compatible
# LLM_API_KEY=your-zhipu-api-key-here
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL_PRIMARY=glm-4-flash

## 方案 4: DeepSeek
# LLM_PROVIDER=compatible
# LLM_API_KEY=your-deepseek-api-key-here
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL_PRIMARY=deepseek-chat

## 方案 5: Mock 模式（无需 API Key，用于测试）
# LLM_PROVIDER=mock
# LLM_API_KEY=
# LLM_MODEL_PRIMARY=mock

# 阿里云 ASR（浏览器 WebM 需转 WAV）：若 Worker 找不到 PATH 中的 ffmpeg，填写 ffmpeg.exe 绝对路径
# FFMPEG_PATH=F:\ffmpeg\bin\ffmpeg.exe

# 其他配置
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=3600
